{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "echo \"API only: no build step\"",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/jobs",
      "schedule": "0 3 * * *"
    }
  ]
}
