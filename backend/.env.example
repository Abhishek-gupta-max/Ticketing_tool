# ---------------------------------------------------------------
# Veltrixsecure Service Desk API - environment variables
# Copy to .env (development) or .env.production and fill in.
# Never commit real values.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tickenting_tools
DB_CONNECTION_LIMIT=10
# Only used by the automated tests (created and dropped by the test run)
DB_NAME_TEST=tickenting_tools_test

# Authentication. JWT_SECRET must be a long random string (at least 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
COOKIE_NAME=vlx_session
# Set to true behind HTTPS (required in production)
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# CORS: the browser origin(s) of the React app, comma separated
FRONTEND_URL=http://localhost:5173

# Rate limiting: API requests per window per signed-in session (per IP when signed out)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_MAX=20

# File uploads
UPLOAD_DIR=src/uploads
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_UPLOAD=10

# Logging: error | warn | info | debug
LOG_LEVEL=info
LOG_DIR=logs

# Background jobs (auto-close resolved tickets, SLA warnings)
JOBS_ENABLED=true

# Serve the built React app (frontend/dist) from the API server
SERVE_FRONTEND=false

# Seeding: password for the seeded admin / demo accounts.
# If empty, a random password is generated and printed once.
SEED_ADMIN_EMAIL=admin@veltrixsecure.example
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
