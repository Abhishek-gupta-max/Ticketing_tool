# Production template. Copy to .env.production on the server (never commit it)
# and start with NODE_ENV=production.
NODE_ENV=production
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=servicedesk_app
DB_PASSWORD=change-me
DB_NAME=tickenting_tools
DB_CONNECTION_LIMIT=20
# true for hosted MySQL that requires TLS (Aiven, TiDB Cloud, PlanetScale...)
DB_SSL=false

# 48+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_NAME=vlx_session
COOKIE_SECURE=true
# lax when the frontend reaches the API on its own origin (reverse proxy or Vercel rewrite);
# none only when the browser calls the API on another site directly
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

FRONTEND_URL=https://servicedesk.example.com

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
LOGIN_RATE_LIMIT_MAX=20

UPLOAD_DIR=/var/lib/servicedesk/uploads
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_UPLOAD=10

LOG_LEVEL=info
LOG_DIR=/var/log/servicedesk

JOBS_ENABLED=true
# Serverless hosting (Vercel): jobs run through GET /api/v1/internal/jobs with
# "Authorization: Bearer <CRON_SECRET>"; empty disables the endpoint
CRON_SECRET=
SERVE_FRONTEND=false

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
