{
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "node $([ -f vercel-build.mjs ] && echo . || echo ..)/vercel-build.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ticketing-tool-backend-taupe.vercel.app/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
