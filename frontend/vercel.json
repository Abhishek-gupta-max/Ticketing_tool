{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "F=frontend; [ -d \"$F\" ] || F=../frontend; node \"$F/node_modules/vite/bin/vite.js\" build \"$F\" --outDir \"$PWD/dist\" --emptyOutDir",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
